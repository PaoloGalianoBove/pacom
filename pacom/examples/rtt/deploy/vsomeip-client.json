{
  "unicast": "${ECU_IP}",
  "logging": {
    "level": "error",
    "console": "true"
  },
  "applications": [
    {
      "name": "${APP_NAME}",
      "id": "${APP_ID_HEX}"
    }
  ],
  "routing": "vsomeip-router",
  "service-discovery": {
    "enable": "true",
    "multicast": "224.224.224.224",
    "port": "30490",
    "protocol": "udp",
    "initial_delay_min": 10,
    "initial_delay_max": 100,
    "repetitions_base_delay": 200,
    "repetitions_max": 3,
    "ttl": "3"
  }
}
